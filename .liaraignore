# Liara upload/build context — keep deploy payload focused on runtime sources.
.git/
.github/
.vscode/
.idea/
screenshots/
artifacts/
coverage/
.nyc_output/
playwright-report/
test-results/
tmp/
temp/
.grok/
# Monorepo: Android projects have their own CI and are never part of the
# Liara upload/build context. Keeping them out reduces deploy payload and
# prevents Android-only changes from affecting website deployment.
android/
android-staff/

# Keep only the canonical FFmpeg and Persian TTF generated at the project root.
# The build provisions these immediately before Vite/Nitro packaging.
.runtime/
!.runtime/ffmpeg/
!.runtime/fonts/
node_modules/
dist/
.output/

.vercel/
.nitro/
.tanstack/
*.log
*.tsbuildinfo
__pycache__/
*.pyc
.node_repl_history
README.md
AGENTS.md
