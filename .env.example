# Required in production for persistent property listings and customer accounts
# Use the PostgreSQL connection string provided by your database service
DATABASE_URL=

# Secret key for /admin panel access (server-only, never expose to client)
HIRMAND_ADMIN_KEY=

# Required in production for shared admin/private-media API rate limiting (Upstash Redis REST).
# Public property/lead intake uses the shared PostgreSQL database limiter instead.
# Copy the HTTPS REST endpoint and its matching REST API token from the same Upstash database.
# Do not use a redis:// connection string; keep both values server-only (never VITE_-prefixed).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical site URL used in SEO meta, Open Graph and sitemap
# Example: https://hirmandrealestate.ir (canonical non-www origin)
VITE_SITE_URL=https://hirmandrealestate.ir

# Customer accounts (email/password plus Google and X sign-in)
VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://hirmandrealestate.ir
# Generate a unique random secret (at least 32 characters); keep server-only.
BETTER_AUTH_SECRET=
# Transactional recovery email. Verify hirmandrealestate.ir in Resend first,
# then use a sender address on that verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Hirmand <accounts@hirmandrealestate.ir>"
# Set true after a production OAuth broker client has been issued and configured.
VITE_GROK_OAUTH_ENABLED=false
# Per-app OAuth broker credentials. The preview-only client is never used in production.
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
# When VITE_GROK_OAUTH_ENABLED=true, register these redirect URLs on the OAuth broker client:
# https://hirmandrealestate.ir/api/auth/oauth2/callback/grok-google
# https://hirmandrealestate.ir/api/auth/oauth2/callback/grok-x
# Optional; defaults to https://auth.grok.me
# GROK_AUTH_ISSUER=https://auth.grok.me

# Liara Object Storage (server-only; never expose credentials to the browser)
LIARA_ENDPOINT=
LIARA_BUCKET_NAME=
LIARA_ACCESS_KEY=
LIARA_SECRET_KEY=

# Optional PostgreSQL pool tuning
# DB_POOL_MAX=5
# DB_POOL_IDLE_MS=10000
# DB_POOL_CONNECT_MS=8000
# DB_QUERY_TIMEOUT_MS=8000
